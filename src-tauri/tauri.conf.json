{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amallo",
  "mainBinaryName": "amallo",
  "version": "1.5.0",
  "identifier": "io.github.opencharui.amallo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Amallo",
        "width": 760,
        "height": 780,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MDQ0QzMzNkMwMzI1QTMKUldTakpRTnNNMHdFbHlNVUZrV1NEbUl2ditBaHAzMXc4emNUMnNvajVCQ0xFRTRXR1ArYTdTcVcK",
      "endpoints": [
        "https://github.com/41tunnels/amallo/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "publisher": "41tunnels",
    "copyright": "Copyright © 41tunnels",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
